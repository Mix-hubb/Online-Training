# Copy to .env and fill in. Never commit .env.
# Local Docker: both the same. Supabase: DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=5,
# DIRECT_URL = Session pooler (port 5432), used only for migrations. See docs/DEPLOY.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_training
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/online_training
JWT_SECRET=change-me
WEB_URL=http://localhost:5173
COOKIE_DOMAIN=

# Google sign-in: OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Use the SAME value as VITE_GOOGLE_CLIENT_ID in web/.env. Only the Client ID is needed, not the secret.
GOOGLE_CLIENT_ID=

# Email (Resend). Without a key, mail is logged to the console in dev.
# MAIL_FROM must use a domain verified in Resend (DNS records added). Before that, Resend's test sender
# onboarding@resend.dev can only send to the email address of the Resend account owner.
# WEB_URL is used in the links inside the emails, so set it to the real site address in production.
RESEND_API_KEY=
MAIL_FROM="Online Training <no-reply@[your-domain]>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video (Bunny Stream, behind VideoProvider)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=

# Images (Bunny Storage). Set all five or none (none = local disk in UPLOAD_DIR). docs/DEPLOY.md step 7A.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_CDN_URL=
BUNNY_STORAGE_PRIVATE_ZONE=
BUNNY_STORAGE_PRIVATE_KEY=
