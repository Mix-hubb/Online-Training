# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/online_training
JWT_SECRET=change-me
WEB_URL=http://localhost:5173
COOKIE_DOMAIN=

GOOGLE_CLIENT_ID=

# Email (Resend). Without a key, mail is logged to the console in dev.
# MAIL_FROM must use a domain verified in Resend (DNS records added). Before that, Resend's test sender
# onboarding@resend.dev can only send to the email address of the Resend account owner.
# WEB_URL is used in the links inside the emails, so set it to the real site address in production.
RESEND_API_KEY=
MAIL_FROM="Online Training <no-reply@[your-domain]>"

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video (Bunny Stream, behind VideoProvider)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=
